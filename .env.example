DATABASE_URL=postgresql://user:password@localhost:5432/fortnite_trading_hub
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
GAME_NAME=Fortnite
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-fortnite
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=your-32-byte-encryption-key-for-aes-256-fortnite
HMAC_SECRET=your-hmac-secret-key-fortnite
MODERATOR_PIN_LENGTH=6
ESCROW_TIMEOUT_MINUTES=20
TRADE_HISTORY_RETENTION_DAYS=365
ADMIN_EMAIL=admin@fortniitetradehub.local
ADMIN_PHONE=+1-555-0100
ENABLE_MIDDLEMAN_ESCROW=true
ENABLE_PEER_RATINGS=true
ENABLE_AI_FRAUD_DETECTION=true
ENABLE_PRICE_FORECASTING=true
ENABLE_V_BUCKS_TRADING=true
ENABLE_COSMETIC_TRADING=true
ENABLE_WEAPON_TRADING=true
DATA_SYNC_CRON=0 * * * *
LOG_LEVEL=info
LOG_FORMAT=json
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=your-session-secret-key-fortnite
